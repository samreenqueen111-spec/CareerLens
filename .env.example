# ==============================================================================
# CareerLens - Environment Configuration Example
# Copy this file to .env and configure values for your environment.
# ==============================================================================

# Flask Core Configuration
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=careerlens_dev_secret_key_change_in_production_9f82d1c3
PORT=5000
HOST=127.0.0.1

# File Upload Settings
MAX_CONTENT_LENGTH=5242880  # 5 MB in bytes
ALLOWED_EXTENSIONS=pdf,docx
UPLOAD_FOLDER=uploads

